{
  "name": "rondas-seguridad",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "dev": "node scripts/dev.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:rules": "firebase emulators:exec --project demo-rondas --only firestore \"node --test tests/rules.integration.cjs\"",
    "test:integration": "firebase emulators:exec --project demo-rondas --only firestore,auth \"node --test tests/system.integration.cjs\"",
    "migrate": "node scripts/migrar.cjs",
    "test:browser": "node tests/browser.cjs"
  },
  "dependencies": {
    "firebase": "12.0.0",
    "firebase-admin": "14.5.0",
    "html5-qrcode": "2.3.8",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "esbuild": "0.25.9",
    "firebase-tools": "15.31.0",
    "jsqr": "1.4.0",
    "playwright": "1.55.1"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    }
  }
}
